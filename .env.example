# Discord Bot Configuration
# Required: Your Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: Guild ID for instant slash command sync during development (leave empty for global sync)
# DISCORD_GUILD_ID=123456789012345678

# Database Infrastructure Credentials (used by Docker Compose)
POSTGRES_DB=refind_cloud
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database Connection String
# Required: PostgreSQL async SQLAlchemy connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/refind_cloud

# Application Environment & Logging
# Optional: LOG_LEVEL (DEBUG, INFO, WARNING, ERROR, CRITICAL) - Default: INFO
LOG_LEVEL=INFO

# Optional: ENVIRONMENT (development, production) - Default: production
# Set to 'development' for human-readable colorized logs, or 'production' for JSON logs
ENVIRONMENT=development
